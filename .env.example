# ─────────────────────────────────────────────
# CORSA Carwash — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local (never commit .env.local)
#
# SUPABASE — Development
# Create your project at https://supabase.com/dashboard
# ─────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────
# SUPABASE — Service Role (NEVER expose in frontend)
# Used only in server-side scripts / Edge Functions / CI migrations
# ─────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Used by scripts/run-migrations.cjs (Supabase Management API)
SUPABASE_ACCESS_TOKEN=your-personal-access-token-here
SUPABASE_PROJECT_REF=your-project-ref-here

# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────
VITE_APP_NAME=CORSA Carwash
VITE_APP_ENV=development

# ─────────────────────────────────────────────
# NOTIFICACIONES PUSH (PWA)
#
# Generar el par con:  node scripts/generar-vapid.mjs
# Guía completa:       docs/NOTIFICACIONES_PUSH.md
# ─────────────────────────────────────────────

# La clave PÚBLICA es pública de verdad: viaja en cada suscripción y en cada
# push. Acá es opcional — sin ella, la app se la pide a la Edge Function al
# suscribirse, que además es la forma de que la clave tenga un solo dueño.
VITE_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────
# Secretos de la Edge Function `push-dispatch`.
#
# NO van en este archivo ni en .env.local: se cargan con
#   supabase secrets set VAPID_PRIVATE_KEY=... --project-ref <ref>
#
# Se listan acá sólo para que se sepa que existen. Con la privada VAPID,
# cualquiera puede mandarle notificaciones a los teléfonos del equipo en
# nombre de CORSA.
#
#   VAPID_PUBLIC_KEY       la pública, base64url
#   VAPID_PRIVATE_KEY      la privada, base64url   ← NUNCA en el frontend
#   VAPID_SUBJECT          mailto: de contacto
#   PUSH_DISPATCH_SECRET   la llave con la que el cron y la base llaman a /run
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# INTEGRATIONS (not implemented yet — do NOT add fake values)
# ─────────────────────────────────────────────
# WHATSAPP_API_KEY=
# EMAIL_API_KEY=
# PAYMENT_PROVIDER_KEY=
# DTE_API_KEY=
